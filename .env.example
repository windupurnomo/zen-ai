# AWS Configuration
AWS_REGION=ap-southeast-1

# AWS SSM Parameter Names (for remote PostgreSQL credentials)
# Set USE_AWS_SSM=true to fetch credentials from AWS SSM
# Set USE_AWS_SSM=false to use local environment variables below
USE_AWS_SSM=true

DB_HOST_PARAM=/todo-api/db/host
DB_PORT_PARAM=/todo-api/db/port
DB_NAME_PARAM=/todo-api/db/name
DB_USER_PARAM=/todo-api/db/user
DB_PASSWORD_PARAM=/todo-api/db/password

# Local Database Configuration (fallback when USE_AWS_SSM=false)
# Only used for local development without AWS SSM
DB_HOST=localhost
DB_PORT=5432
DB_NAME=todo_db
DB_USER=postgres
DB_PASSWORD=your_password_here
